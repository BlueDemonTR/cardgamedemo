function scr_initialize_activation_box_functions(){
	activationBoxText[FunctionAttack] = "Attack"
	activationBoxText[FunctionFieldEffect] = "Effect"
	activationBoxText[FunctionHandEffect] = "Effect"
	activationBoxText[FunctionInfirmaryEffect] = "Effect"
	activationBoxText[FunctionSacrifice] = "Sacrifice"
}