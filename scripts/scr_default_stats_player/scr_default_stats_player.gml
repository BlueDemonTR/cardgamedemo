// Script assets have changed for v2.3.0 see
// https://help.yoyogames.com/hc/en-Player/articles/360005277377 for more information
function scr_default_stats_player(){
	defaultStatPlayer[PlayerMana] = 0;
	defaultStatPlayer[PlayerMaxMana] = 8;
	defaultStatPlayer[PlayerMomentum] = 0;
	defaultStatPlayer[PlayerMaxMomentum] = 12;
	defaultStatPlayer[PlayerMaxHP] = 60;
	defaultStatPlayer[PlayerHP] = defaultStatPlayer[PlayerMaxHP];
}