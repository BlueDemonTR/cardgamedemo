function scr_initialize_send_types(){
	sendTypeName[SendInvalid] = "Invalid"
	sendTypeName[SendDiscard] = "Discard"
	sendTypeName[SendEffect] = "By an Effect"
	sendTypeName[SendInjuries] = "By Battle"
	sendTypeName[SendMaterial] = "Used as Material"
	sendTypeName[SendMill] = "Milled from Deck"
}